<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category><text>$course$/top/命令模式</text></category>
  </question>
  <question type="multichoice">
    <name><text>命令模式核心概念</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>命令</strong>模式主要做什麼?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>將一個請求封裝成帶有 execute() 方法的物件</text><feedback><text>正確 —— 請求成為第一級物件。</text></feedback></answer>
    <answer fraction="0"><text>定義一組可互換的演算法</text><feedback><text>那是策略模式。</text></feedback></answer>
    <answer fraction="0"><text>當主體改變時通知眾多觀察者</text><feedback><text>那是觀察者模式。</text></feedback></answer>
    <answer fraction="0"><text>在不指定具體類別的情況下建立物件</text><feedback><text>那是工廠模式。</text></feedback></answer>
    <generalfeedback><text>命令模式將請求變成獨立物件並提供 execute(),這正是能支援復原、排隊與記錄的原因。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>命令模式的解耦</text></name>
    <questiontext format="html"><text><![CDATA[<p>命令模式將哪兩個角色彼此解耦?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>呼叫者(invoker)與接收者(receiver)</text><feedback><text>正確 —— 呼叫者觸發 execute() 而不需知道接收者。</text></feedback></answer>
    <answer fraction="0"><text>模型與視圖</text><feedback><text>那是 MVC 的分離。</text></feedback></answer>
    <answer fraction="0"><text>發布者與代理</text><feedback><text>那屬於發布/訂閱。</text></feedback></answer>
    <answer fraction="0"><text>過濾器與管道</text><feedback><text>那屬於管道與過濾器。</text></feedback></answer>
    <generalfeedback><text>呼叫者持有 Command 並呼叫 execute();具體命令再把工作轉交給接收者,因此兩者不直接互相參考。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>命令模式的能力</text></name>
    <questiontext format="html"><text><![CDATA[<p>由於命令記錄了請求,下列哪項功能自然而然得到支援?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>操作的復原/重做</text><feedback><text>正確 —— 儲存命令即可反向或重播它們。</text></feedback></answer>
    <answer fraction="0"><text>編譯期型別推導</text><feedback><text>那與此模式無關。</text></feedback></answer>
    <answer fraction="0"><text>自動垃圾回收</text><feedback><text>那是執行環境功能,非來自命令模式。</text></feedback></answer>
    <answer fraction="0"><text>硬體中斷處理</text><feedback><text>這不是此模式所提供的。</text></feedback></answer>
    <generalfeedback><text>將命令物件保存在歷史紀錄中可支援復原/重做;放入清單則可支援排隊與記錄。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>巨集命令</text></name>
    <questiontext format="html"><text><![CDATA[<p>把數個命令組合起來並當作單一單位執行的命令,稱為 ______。</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>巨集命令(組合命令)</text><feedback><text>正確 —— 它組合了多個命令。</text></feedback></answer>
    <answer fraction="0"><text>單例命令</text><feedback><text>單例是關於單一實例,而非分組。</text></feedback></answer>
    <answer fraction="0"><text>空命令</text><feedback><text>空命令什麼都不做,並非組合命令。</text></feedback></answer>
    <answer fraction="0"><text>代理命令</text><feedback><text>代理是替另一物件站位,並非分組。</text></feedback></answer>
    <generalfeedback><text>巨集(組合)命令持有一份命令清單,並對每個呼叫 execute(),以支援批次操作。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>命令模式的好處(複選)</text></name>
    <questiontext format="html"><text><![CDATA[<p>關於命令模式,以下哪些敘述正確?<em>(複選)</em></p>]]></text></questiontext>
    <single>false</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="50"><text>請求可以被排隊、記錄與重播</text><feedback><text>正確 —— 因為每個請求都是物件。</text></feedback></answer>
    <answer fraction="50"><text>透過儲存命令歷史可支援復原/重做</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="-50"><text>它要求呼叫者知道接收者的具體類別</text><feedback><text>錯 —— 那會破壞解耦。</text></feedback></answer>
    <answer fraction="-50"><text>它是一種用於建立物件家族的建立型模式</text><feedback><text>錯 —— 命令是行為型模式。</text></feedback></answer>
    <generalfeedback><text>命令是行為型模式:它將請求物件化以支援排隊、記錄、重播與復原/重做,同時解耦呼叫者與接收者。</text></generalfeedback>
  </question>
  <question type="truefalse">
    <name><text>命令支援復原</text></name>
    <questiontext format="html"><text><![CDATA[<p>命令模式讓復原/重做與操作排隊變得簡單直接。</p>]]></text></questiontext>
    <answer fraction="100"><text>true</text><feedback><text>正確 —— 物件化的請求可被儲存與反向。</text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback><text>復原/重做與排隊正是命令模式的招牌好處。</text></feedback></answer>
  </question>
  <question type="truefalse">
    <name><text>命令 vs 策略</text></name>
    <questiontext format="html"><text><![CDATA[<p>命令模式主要是關於在執行期於可互換的演算法之間做選擇。</p>]]></text></questiontext>
    <answer fraction="0"><text>true</text><feedback><text>那描述的是策略模式,而非命令模式。</text></feedback></answer>
    <answer fraction="100"><text>false</text><feedback><text>正確 —— 那是策略;命令是將請求物件化。</text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>模式名稱</text></name>
    <questiontext format="html"><text><![CDATA[<p>把請求封裝成帶有 execute() 方法之物件的行為型模式,稱為 ______ 模式。(英文單字)</p>]]></text></questiontext>
    <usecase>0</usecase>
    <answer fraction="100"><text>command</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>command*</text><feedback><text>正確。</text></feedback></answer>
  </question>
</quiz>
