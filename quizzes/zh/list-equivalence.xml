<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category><text>$course$/top/Equivalence Classes</text></category>
  </question>
  <question type="multichoice">
    <name><text>等價關係的性質</text></name>
    <questiontext format="html"><text><![CDATA[<p><strong>等價關係</strong>必須是:</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>反身、對稱且遞移</text><feedback><text>正確 —— 這三個性質定義了等價關係。</text></feedback></answer>
    <answer fraction="0"><text>只需反身</text><feedback><text>光有反身不夠;還需要對稱與遞移。</text></feedback></answer>
    <answer fraction="0"><text>反對稱且遞移</text><feedback><text>那是偏序關係,不是等價關係。</text></feedback></answer>
    <answer fraction="0"><text>對稱但不遞移</text><feedback><text>等價關係必須具備遞移性。</text></feedback></answer>
    <generalfeedback><text>等價關係具反身、對稱與遞移性;它把集合分割成等價類。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>相關的資料結構</text></name>
    <questiontext format="html"><text><![CDATA[<p>由相關配對計算等價類,與哪一種資料結構關係最密切?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>互斥集合(union-find)</text><feedback><text>正確 —— 合併相關配對正是 union-find。</text></feedback></answer>
    <answer fraction="0"><text>最大堆積</text><feedback><text>堆積依優先權排序,並不合併類別。</text></feedback></answer>
    <answer fraction="0"><text>紅黑樹</text><feedback><text>平衡 BST 依鍵值排序,並不計算連通類別。</text></feedback></answer>
    <answer fraction="0"><text>鏈結法的雜湊表</text><feedback><text>雜湊用於定位鍵值,本身並不合併等價類。</text></feedback></answer>
    <generalfeedback><text>把相關配對的元素合併成類別,就是互斥集合(union-find)問題。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>類別分割集合</text></name>
    <questiontext format="html"><text><![CDATA[<p>一個關係的等價類會構成基礎集合的一個 ______。</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>分割(互斥且覆蓋整個集合的子集)</text><feedback><text>正確 —— 每個元素恰好落在一個類別中。</text></feedback></answer>
    <answer fraction="0"><text>全序</text><feedback><text>等價關係將元素分組,而非排序。</text></feedback></answer>
    <answer fraction="0"><text>含重複的多重集合</text><feedback><text>類別是互斥集合,不是多重集合。</text></feedback></answer>
    <answer fraction="0"><text>單一環</text><feedback><text>類別是子集,不是環狀序列。</text></feedback></answer>
    <generalfeedback><text>等價類分割集合:這些子集互斥,且合起來涵蓋每一個元素。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>union-find 的操作</text></name>
    <questiontext format="html"><text><![CDATA[<p>互斥集合(union-find)結構提供哪一對操作來建立等價類?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>Union(合併兩個類別)與 Find(找到代表元)</text><feedback><text>正確 —— Union 合併、Find 回傳類別代表元。</text></feedback></answer>
    <answer fraction="0"><text>Push 與 Pop</text><feedback><text>那是堆疊的操作。</text></feedback></answer>
    <answer fraction="0"><text>Enqueue 與 Dequeue</text><feedback><text>那是佇列的操作。</text></feedback></answer>
    <answer fraction="0"><text>Insert 與 Delete-min</text><feedback><text>那屬於優先佇列。</text></feedback></answer>
    <generalfeedback><text>union-find 提供 Union(合併類別)與 Find(代表元),由相關配對建立等價類。</text></generalfeedback>
  </question>
  <question type="truefalse">
    <name><text>合併成類別</text></name>
    <questiontext format="html"><text><![CDATA[<p>合併相關的配對會將元素分組成連通的等價類。</p>]]></text></questiontext>
    <answer fraction="100"><text>true</text><feedback><text>正確 —— 具遞移關聯的元素最終會落在同一類。</text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback><text>處理這些配對確實會把元素合併成連通的類別。</text></feedback></answer>
  </question>
  <question type="truefalse">
    <name><text>遞移性的要求</text></name>
    <questiontext format="html"><text><![CDATA[<p>等價關係不一定要具備遞移性。</p>]]></text></questiontext>
    <answer fraction="0"><text>true</text><feedback><text>遞移性是三個必要性質之一。</text></feedback></answer>
    <answer fraction="100"><text>false</text><feedback><text>正確 —— 等價關係必須同時具反身、對稱「與」遞移性。</text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>關係名詞</text></name>
    <questiontext format="html"><text><![CDATA[<p>同時具反身、對稱與遞移性的關係稱為 ______ 關係。(請以英文作答)</p>]]></text></questiontext>
    <usecase>0</usecase>
    <answer fraction="100"><text>equivalence</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>class</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>equivalence*</text><feedback><text>正確。</text></feedback></answer>
  </question>
  <question type="multichoice">
    <name><text>等價類的性質</text></name>
    <questiontext format="html"><text><![CDATA[<p>關於等價類,以下哪些敘述正確?<em>(複選)</em></p>]]></text></questiontext>
    <single>false</single>
    <answer fraction="50"><text>此關係具反身、對稱與遞移性</text><feedback><text>正確 —— 這三個性質定義了它。</text></feedback></answer>
    <answer fraction="50"><text>此問題可用互斥集合(union-find)結構求解</text><feedback><text>正確 —— union-find 能有效率地合併相關元素。</text></feedback></answer>
    <answer fraction="-50"><text>每個元素會同時屬於多個相異類別</text><feedback><text>錯 —— 這些類別會分割集合,每個元素恰屬於一類。</text></feedback></answer>
    <answer fraction="-50"><text>此關係必須具反對稱性</text><feedback><text>錯 —— 反對稱屬於偏序,而非等價關係。</text></feedback></answer>
    <generalfeedback><text>等價類:反身/對稱/遞移的關係、可用 union-find 求解,並將集合分割(每個元素一類)。</text></generalfeedback>
  </question>
</quiz>
