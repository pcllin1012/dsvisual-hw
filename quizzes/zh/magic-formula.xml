<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category><text>$course$/top/Magic Square (Formula)</text></category>
  </question>
  <question type="multichoice">
    <name><text>getValue 成本</text></name>
    <questiontext format="html"><text><![CDATA[<p>使用封閉形式公式,計算格子 (i, j) 數值所需的時間為何?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>O(1)</text><feedback><text>正確 —— 固定的算術式,與 n 無關。</text></feedback></answer>
    <answer fraction="0"><text>O(n)</text><feedback><text>不需遍歷一整列;它是常數時間。</text></feedback></answer>
    <answer fraction="0"><text>O(n^2)</text><feedback><text>那意味要建整個方格;公式避開了這點。</text></feedback></answer>
    <answer fraction="0"><text>O(log n)</text><feedback><text>不涉及搜尋;只是單純算術。</text></feedback></answer>
    <generalfeedback><text>公式把 i 與 j 代入固定算術式,所以每次查詢為 O(1)。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>不需方格</text></name>
    <questiontext format="html"><text><![CDATA[<p>封閉形式作法讓你得以避免什麼?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>建構並儲存整個 n x n 方格</text><feedback><text>正確 —— 數值依需求由索引即時算出。</text></feedback></answer>
    <answer fraction="0"><text>使用索引 i 與 j</text><feedback><text>公式正是依 i 與 j 而定。</text></feedback></answer>
    <answer fraction="0"><text>知道階數 n</text><feedback><text>公式仍以 n 為參數。</text></feedback></answer>
    <answer fraction="0"><text>計算魔術常數</text><feedback><text>魔術常數是另一件事,仍可計算。</text></feedback></answer>
    <generalfeedback><text>封閉形式的 getValue(i, j) 直接算出每個元素,因此無需建構或儲存方格陣列。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>公式的輸入</text></name>
    <questiontext format="html"><text><![CDATA[<p>O(1) 公式直接由什麼計算出數值?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>索引 i 與 j(以及階數 n)</text><feedback><text>正確 —— 對座標做算術即得數值。</text></feedback></answer>
    <answer fraction="0"><text>對預先計算好的表格查詢</text><feedback><text>表格需 O(n^2) 儲存;公式無需。</text></feedback></answer>
    <answer fraction="0"><text>相鄰格子的數值</text><feedback><text>不參考鄰居;只用索引。</text></feedback></answer>
    <answer fraction="0"><text>一個隨機種子</text><feedback><text>結果是確定性的,不是隨機。</text></feedback></answer>
    <generalfeedback><text>數值是 i、j 與 n 的確定性算術函數。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>空間效益</text></name>
    <questiontext format="html"><text><![CDATA[<p>相較於建構方格,封閉形式的 getValue 為儲存數值需要多少額外空間?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>O(1) —— 不儲存數值陣列</text><feedback><text>正確 —— 每次呼叫重新計算數值。</text></feedback></answer>
    <answer fraction="0"><text>O(n) —— 快取一整列</text><feedback><text>公式不需快取任何列。</text></feedback></answer>
    <answer fraction="0"><text>O(n^2) —— 儲存整個方格</text><feedback><text>那正是公式所避免的。</text></feedback></answer>
    <answer fraction="0"><text>O(log n)</text><feedback><text>不需要那種大小的輔助結構。</text></feedback></answer>
    <generalfeedback><text>依需求計算數值代表不需方格陣列,故數值儲存為 O(1)。</text></generalfeedback>
  </question>
  <question type="truefalse">
    <name><text>常數時間查詢</text></name>
    <questiontext format="html"><text><![CDATA[<p>封閉形式的 getValue(i, j) 以 O(1) 時間回傳其結果。</p>]]></text></questiontext>
    <answer fraction="100"><text>true</text><feedback><text>正確 —— 固定數目的算術運算。</text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback><text>它是常數時間;不需遍歷方格。</text></feedback></answer>
  </question>
  <question type="truefalse">
    <name><text>必須建方格的迷思</text></name>
    <questiontext format="html"><text><![CDATA[<p>用封閉形式法讀取一個數值,必須先建構整個 n x n 方格。</p>]]></text></questiontext>
    <answer fraction="0"><text>true</text><feedback><text>公式直接算出單一數值,無需建構方格。</text></feedback></answer>
    <answer fraction="100"><text>false</text><feedback><text>正確 —— 不需要建構方格。</text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>直接計算名詞</text></name>
    <questiontext format="html"><text><![CDATA[<p>能由索引直接算出 (i, j) 數值的封閉形式算術式,稱為一個 ______(英文)。</p>]]></text></questiontext>
    <usecase>0</usecase>
    <answer fraction="100"><text>formula</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>formula*</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>O(1)</text><feedback><text>可接受 —— 公式以 O(1) 時間執行。</text></feedback></answer>
  </question>
  <question type="multichoice">
    <name><text>公式法性質</text></name>
    <questiontext format="html"><text><![CDATA[<p>關於封閉形式的 getValue,以下哪些敘述正確?<em>(複選)</em></p>]]></text></questiontext>
    <single>false</single>
    <answer fraction="50"><text>它以 O(1) 時間計算每個元素</text><feedback><text>正確 —— 固定的算術式。</text></feedback></answer>
    <answer fraction="50"><text>它不需要儲存 n x n 方格</text><feedback><text>正確 —— 數值依需求計算。</text></feedback></answer>
    <answer fraction="-50"><text>它必須先預先計算並儲存全部 n^2 個數值</text><feedback><text>錯 —— 那違背了公式的用意。</text></feedback></answer>
    <answer fraction="-50"><text>它忽略索引 i 與 j</text><feedback><text>錯 —— 數值是 i 與 j 的函數。</text></feedback></answer>
    <generalfeedback><text>公式以 O(1) 將 (i, j) 對映到數值,不需儲存方格。</text></generalfeedback>
  </question>
</quiz>
