<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category><text>$course$/top/Magic Square (Symmetry)</text></category>
  </question>
  <question type="multichoice">
    <name><text>對稱群的階</text></name>
    <questiontext format="html"><text><![CDATA[<p>正方形的對稱群(D4)有多少個元素?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>8</text><feedback><text>正確 —— 4 個旋轉與 4 個鏡射。</text></feedback></answer>
    <answer fraction="0"><text>4</text><feedback><text>那只算了旋轉,漏掉了鏡射。</text></feedback></answer>
    <answer fraction="0"><text>2</text><feedback><text>太少;D4 的階為 8。</text></feedback></answer>
    <answer fraction="0"><text>16</text><feedback><text>太多;D4 恰好有 8 個元素。</text></feedback></answer>
    <generalfeedback><text>正方形的二面體群 D4 的階為 8:四個旋轉加四個鏡射。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>旋轉角度</text></name>
    <questiontext format="html"><text><![CDATA[<p>哪一組旋轉屬於正方形的對稱群?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>0、90、180、270 度</text><feedback><text>正確 —— 正方形的四個旋轉對稱。</text></feedback></answer>
    <answer fraction="0"><text>只有 0 與 180 度</text><feedback><text>90 與 270 度也是正方形的對稱。</text></feedback></answer>
    <answer fraction="0"><text>0、60、120、180、240、300 度</text><feedback><text>那是六邊形的旋轉,不是正方形。</text></feedback></answer>
    <answer fraction="0"><text>任意實數角度</text><feedback><text>只有 90 度的倍數能讓正方形映到自身。</text></feedback></answer>
    <generalfeedback><text>正方形在 0、90、180、270 度旋轉下不變。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>對稱保持魔術性</text></name>
    <questiontext format="html"><text><![CDATA[<p>對魔術方陣套用一個 D4 對稱會產生...</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>另一個魔術方陣</text><feedback><text>正確 —— 旋轉與鏡射保持魔術性質。</text></feedback></answer>
    <answer fraction="0"><text>一個永遠不是魔術的方陣</text><feedback><text>對稱會把魔術方陣映到魔術方陣。</text></feedback></answer>
    <answer fraction="0"><text>一個非方形的格子</text><feedback><text>對稱維持 n x n 形狀。</text></feedback></answer>
    <answer fraction="0"><text>一個數字不同的格子</text><feedback><text>相同數字被重新排列,且仍保持魔術性。</text></feedback></answer>
    <generalfeedback><text>8 個對稱各自置換格子,使所有線的總和維持不變,得到另一個魔術方陣。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>鏡射數目</text></name>
    <questiontext format="html"><text><![CDATA[<p>正方形(D4)有幾個鏡射對稱?</p>]]></text></questiontext>
    <single>true</single>
    <answer fraction="100"><text>4</text><feedback><text>正確 —— 兩條過邊中點、兩條過對角線。</text></feedback></answer>
    <answer fraction="0"><text>2</text><feedback><text>有四條鏡射軸,不是兩條。</text></feedback></answer>
    <answer fraction="0"><text>8</text><feedback><text>8 是整個群的階;鏡射有 4 個。</text></feedback></answer>
    <answer fraction="0"><text>0</text><feedback><text>正方形確實有鏡射對稱。</text></feedback></answer>
    <generalfeedback><text>D4 有 4 條鏡射軸:兩條對角線與兩條過對邊中點。</text></generalfeedback>
  </question>
  <question type="truefalse">
    <name><text>階為 8 的群</text></name>
    <questiontext format="html"><text><![CDATA[<p>正方形的對稱群 D4 階為 8,由 4 個旋轉與 4 個鏡射組成。</p>]]></text></questiontext>
    <answer fraction="100"><text>true</text><feedback><text>正確 —— 4 + 4 = 8 個對稱。</text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback><text>D4 確實有 8 個元素:4 個旋轉與 4 個鏡射。</text></feedback></answer>
  </question>
  <question type="truefalse">
    <name><text>破壞魔術性的迷思</text></name>
    <questiontext format="html"><text><![CDATA[<p>將魔術方陣旋轉 90 度一定會破壞其魔術性質。</p>]]></text></questiontext>
    <answer fraction="0"><text>true</text><feedback><text>90 度旋轉是一種對稱;結果仍是魔術方陣。</text></feedback></answer>
    <answer fraction="100"><text>false</text><feedback><text>正確 —— 旋轉把魔術方陣映到另一個魔術方陣。</text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>對稱群名詞</text></name>
    <questiontext format="html"><text><![CDATA[<p>正方形的 8 個旋轉與鏡射所成的群,是 ______(英文)群 D4。</p>]]></text></questiontext>
    <usecase>0</usecase>
    <answer fraction="100"><text>dihedral</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>dihedral*</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>D4</text><feedback><text>可接受 —— D4 是正方形的二面體群。</text></feedback></answer>
    <answer fraction="100"><text>8</text><feedback><text>可接受 —— 該群的階為 8。</text></feedback></answer>
  </question>
  <question type="multichoice">
    <name><text>D4 對稱性質</text></name>
    <questiontext format="html"><text><![CDATA[<p>關於正方形的對稱群 D4,以下哪些敘述正確?<em>(複選)</em></p>]]></text></questiontext>
    <single>false</single>
    <answer fraction="50"><text>它的階為 8:4 個旋轉與 4 個鏡射</text><feedback><text>正確 —— 正方形的二面體群。</text></feedback></answer>
    <answer fraction="50"><text>每個對稱把魔術方陣映到另一個魔術方陣</text><feedback><text>正確 —— 線的總和被保持。</text></feedback></answer>
    <answer fraction="-50"><text>它包含任意實數角度的旋轉</text><feedback><text>錯 —— 只有 0、90、180、270 度。</text></feedback></answer>
    <answer fraction="-50"><text>它總共只有 4 個元素</text><feedback><text>錯 —— 4 只是旋轉;總階為 8。</text></feedback></answer>
    <generalfeedback><text>D4 階為 8(4 旋轉 + 4 鏡射),且每個對稱把魔術方陣送到另一個魔術方陣。</text></generalfeedback>
  </question>
</quiz>
