<?xml version="1.0" encoding="UTF-8"?>
<quiz>
  <question type="category">
    <category><text>$course$/top/模型-視圖-控制器</text></category>
  </question>
  <question type="multichoice">
    <name><text>MVC 三部分</text></name>
    <questiontext format="html"><text><![CDATA[<p>MVC 把系統分成哪三種職責?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>模型(資料/狀態)、視圖(呈現)、控制器(輸入處理)</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="0"><text>發布者、代理、訂閱者</text><feedback><text>那是發布/訂閱。</text></feedback></answer>
    <answer fraction="0"><text>呼叫者、命令、接收者</text><feedback><text>那是命令模式。</text></feedback></answer>
    <answer fraction="0"><text>來源、過濾器、匯出</text><feedback><text>那類似管道與過濾器。</text></feedback></answer>
    <generalfeedback><text>MVC 把職責分為模型(資料與業務狀態)、視圖(呈現)、控制器(處理使用者輸入)。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>MVC 模型的角色</text></name>
    <questiontext format="html"><text><![CDATA[<p>哪個元件持有應用程式的資料與業務狀態?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>模型</text><feedback><text>正確 —— 模型擁有資料與規則。</text></feedback></answer>
    <answer fraction="0"><text>視圖</text><feedback><text>視圖只負責呈現資料。</text></feedback></answer>
    <answer fraction="0"><text>控制器</text><feedback><text>控制器處理輸入,而非核心狀態。</text></feedback></answer>
    <answer fraction="0"><text>路由器</text><feedback><text>那不是 MVC 三大核心角色之一。</text></feedback></answer>
    <generalfeedback><text>模型封裝資料與業務邏輯,與其如何顯示無關。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>MVC 視圖與模型的連結</text></name>
    <questiontext format="html"><text><![CDATA[<p>視圖通常如何與模型保持同步?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>視圖觀察模型,並在其改變時更新</text><feedback><text>正確 —— MVC 運用了觀察者關係。</text></feedback></answer>
    <answer fraction="0"><text>模型直接伸入視圖去重繪它</text><feedback><text>錯 —— 那會讓模型耦合到視圖。</text></feedback></answer>
    <answer fraction="0"><text>它們共用同一個類別</text><feedback><text>MVC 讓它們保持分離。</text></feedback></answer>
    <answer fraction="0"><text>它們從不溝通</text><feedback><text>視圖必須反映模型狀態。</text></feedback></answer>
    <generalfeedback><text>視圖觀察模型(觀察者模式);當模型狀態改變時,視圖更新其呈現。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>MVC 主要好處</text></name>
    <questiontext format="html"><text><![CDATA[<p>MVC 的主要好處是什麼?</p>]]></text></questiontext>
    <single>true</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="100"><text>它讓使用者介面與業務邏輯解耦</text><feedback><text>正確 —— UI 與邏輯可獨立演進。</text></feedback></answer>
    <answer fraction="0"><text>它保證 O(1) 的資料庫查詢</text><feedback><text>與此模式無關。</text></feedback></answer>
    <answer fraction="0"><text>它讓資料儲存變得不必要</text><feedback><text>MVC 並不會消除儲存需求。</text></feedback></answer>
    <answer fraction="0"><text>它把呈現與資料合併成一個類別</text><feedback><text>MVC 恰恰相反 —— 它把它們分開。</text></feedback></answer>
    <generalfeedback><text>藉由分離模型、視圖與控制器,MVC 讓 UI 呈現與業務邏輯解耦,提升可維護性與可測試性。</text></generalfeedback>
  </question>
  <question type="multichoice">
    <name><text>MVC 特性(複選)</text></name>
    <questiontext format="html"><text><![CDATA[<p>關於 MVC,以下哪些敘述正確?<em>(複選)</em></p>]]></text></questiontext>
    <single>false</single>
    <shuffleanswers>1</shuffleanswers>
    <answer fraction="50"><text>控制器把使用者輸入轉換成對模型的操作</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="50"><text>視圖負責呈現</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="-50"><text>視圖應包含核心業務規則</text><feedback><text>錯 —— 業務規則屬於模型。</text></feedback></answer>
    <answer fraction="-50"><text>模型必須知道具體的視圖類別</text><feedback><text>錯 —— 模型獨立於特定視圖。</text></feedback></answer>
    <generalfeedback><text>MVC 把呈現交給視圖、輸入處理交給控制器、資料與業務規則交給模型,並讓它們保持解耦。</text></generalfeedback>
  </question>
  <question type="truefalse">
    <name><text>MVC 解耦</text></name>
    <questiontext format="html"><text><![CDATA[<p>MVC 讓使用者介面與底層的業務邏輯解耦。</p>]]></text></questiontext>
    <answer fraction="100"><text>true</text><feedback><text>正確 —— 那個分離正是 MVC 的重點。</text></feedback></answer>
    <answer fraction="0"><text>false</text><feedback><text>UI 與邏輯解耦正是 MVC 所提供的。</text></feedback></answer>
  </question>
  <question type="truefalse">
    <name><text>MVC 業務規則的位置</text></name>
    <questiontext format="html"><text><![CDATA[<p>在 MVC 中,核心業務邏輯應放在視圖裡。</p>]]></text></questiontext>
    <answer fraction="0"><text>true</text><feedback><text>錯 —— 業務邏輯屬於模型。</text></feedback></answer>
    <answer fraction="100"><text>false</text><feedback><text>正確 —— 模型擁有業務邏輯;視圖只負責呈現。</text></feedback></answer>
  </question>
  <question type="shortanswer">
    <name><text>元件名稱</text></name>
    <questiontext format="html"><text><![CDATA[<p>在 MVC 中,持有應用程式資料與業務狀態的元件稱為 ______。(英文單字)</p>]]></text></questiontext>
    <usecase>0</usecase>
    <answer fraction="100"><text>model</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>model*</text><feedback><text>正確。</text></feedback></answer>
    <answer fraction="100"><text>MVC</text><feedback><text>接受 —— 指該架構本身。</text></feedback></answer>
  </question>
</quiz>
